{"schema_version": "1.0", "session_id": "8745c2a3-fe90-4d14-ab95-7d4b77fc9036", "team_id": "contest2026_315_Corelink", "github_login": "xvkjdshknxs2", "tool": "claude-code", "seq": 17, "ts": "2026-08-25T03:33:53.053Z", "role": "tool", "tool_name": "<result>", "tool_call_id": "call_f725c980bb3d4e20a6ec103c", "input": null, "output": "1\t<template>\n2\t  <scroll class=\"page\" scroll-y=\"true\" style=\"height: {{ scrollH }}px;\">\n3\t    <div class=\"content\" style=\"padding: {{ contentPad }};\">\n4\t      <!-- 顶部栏 -->\n5\t      <div class=\"topbar\">\n6\t        <text class=\"clock\" style=\"font-size: {{ fs22 }}px;\">{{ clockText }}</text>\n7\t        <div class=\"top-right\">\n8\t          <text class=\"queue-chip\" if=\"{{ pendingCount > 0 }}\" style=\"font-size: {{ fs9 }}px;\">{{ pendingCount }} 待补发</text>\n9\t          <text class=\"badge {{ networkClass }}\" style=\"font-size: {{ fs9 }}px;\">{{ networkText }}</text>\n10\t        </div>\n11\t      </div>\n12\t\n13\t      <!-- 安全状态卡（带左侧 accent 条） -->\n14\t      <div class=\"card status-card {{ statusClass }}\" style=\"border-radius: {{ cr }}px; padding: {{ cardPad }}px;\">\n15\t        <div class=\"accent-bar status-accent\"></div>\n16\t        <div class=\"card-body\">\n17\t          <div class=\"status-head\">\n18\t            <div class=\"status-dot\"></div>\n19\t            <text class=\"status-kicker\" style=\"font-size: {{ fs10 }}px;\">{{ statusKicker }}</text>\n20\t          </div>\n21\t          <text class=\"status-title\" style=\"font-size: {{ fs22 }}px;\">{{ statusTitle }}</text>\n22\t          <text class=\"status-desc\" style=\"font-size: {{ fs12 }}px;\">{{ statusDescription }}</text>\n23\t        </div>\n24\t      </div>\n25\t\n26\t      <!-- 指标行 -->\n27\t      <div class=\"metrics-row\">\n28\t        <!-- 步数卡 -->\n29\t        <div class=\"card metric-card\" style=\"border-radius: {{ cr }}px; padding: {{ metricPad }}px;\">\n30\t          <div class=\"accent-bar accent-green\"></div>\n31\t          <div class=\"metric-body\">\n32\t            <text class=\"metric-icon\" style=\"font-size: {{ fs16 }}px;\">⚡</text>\n33\t            <text class=\"metric-value\" style=\"font-size: {{ fs24 }}px;\">{{ stepCount }}</text>\n34\t            <text class=\"metric-label\" style=\"font-size: {{ fs9 }}px;\">步数</text>\n35\t            <div class=\"bar-track\"><div class=\"bar-fill bar-green\" style=\"width: {{ stepProgress }}%;\"></div></div>\n36\t          </div>\n37\t        </div>\n38\t        <!-- 心率卡 -->\n39\t        <div class=\"card metric-card\" style=\"border-radius: {{ cr }}px; padding: {{ metricPad }}px;\">\n40\t          <div class=\"accent-bar accent-red\"></div>\n41\t          <div class=\"metric-body\">\n42\t            <text class=\"metric-icon\" style=\"font-size: {{ fs16 }}px;\">♥</text>\n43\t            <text class=\"metric-value {{ hrClass }}\" style=\"font-size: {{ fs24 }}px;\">{{ heartRate }}</text>\n44\t            <text class=\"metric-label\" style=\"font-size: {{ fs9 }}px;\">心率 {{ hrZone }}</text>\n45\t            <div class=\"bar-track\"><div class=\"bar-fill bar-red\" style=\"width: {{ hrBar }}%;\"></div></div>\n46\t          </div>\n47\t        </div>\n48\t      </div>\n49\t\n50\t      <!-- SOS 按钮（呼吸灯效果） -->\n51\t      <input class=\"sos-btn\" type=\"button\" value=\"{{ sosLabel }}\" onclick=\"triggerSos\" onlongpress=\"triggerSosLong\"\n52\t             style=\"border-radius: {{ br }}px; font-size: {{ fs16 }}px; opacity: {{ sosOpacity }};\" />\n53\t\n54\t      <!-- 最近事件 -->\n55\t      <div class=\"card quick-event\" if=\"{{ hasRecentEvent }}\" onclick=\"openRecentEvent\"\n56\t           style=\"border-radius: {{ cr }}px; padding: {{ quickPad }}px;\">\n57\t        <div class=\"qe-left\">\n58\t          <div class=\"qe-icon {{ recentEventIconClass }}\">\n59\t            <text class=\"qe-icon-text\" style=\"font-size: {{ fs14 }}px;\">{{ recentEventIcon }}</text>\n60\t          </div>\n61\t          <div class=\"qe-body\">\n62\t            <text class=\"qe-title\" style=\"font-size: {{ fs13 }}px;\">{{ recentEventType }}</text>\n63\t            <text class=\"qe-time\" style=\"font-size: {{ fs10 }}px;\">{{ recentEventTime }}</text>\n64\t          </div>\n65\t        </div>\n66\t        <text class=\"qe-arrow\" style=\"font-size: {{ fs18 }}px;\">›</text>\n67\t      </div>\n68\t\n69\t      <!-- 导航 -->\n70\t      <div class=\"nav-row\">\n71\t        <input class=\"nav-btn\" type=\"button\" value=\"场景测试\" onclick=\"openScenarios\"\n72\t               style=\"border-radius: {{ br }}px; font-size: {{ fs12 }}px; opacity: {{ navOpacity }};\" />\n73\t        <input class=\"nav-btn\" type=\"button\" value=\"事件历史\" onclick=\"openHistory\"\n74\t               style=\"border-radius: {{ br }}px; font-size: {{ fs12 }}px; opacity: {{ navOpacity }};\" />\n75\t      </div>\n76\t\n77\t      <text class=\"hint\" if=\"{{ pressureHint }}\" style=\"font-size: {{ fs9 }}px;\">气压{{ pressureHint }}，注意天气</text>\n78\t      <text class=\"footer-note\" style=\"font-size: {{ fs8 }}px;\">安全辅助原型 · 不用于医疗诊断</text>\n79\t    </div>\n80\t  </scroll>\n81\t</template>\n82\t\n83\t<script>\n84\timport router from \"@system.router\"\n85\timport network from \"@system.network\"\n86\timport { createWindow, pushSample, resetWindow, assessWindow } from \"../../common/fall-model.js\"\n87\timport { createAlert, createSosAlert, formatTime } from \"../../common/event-machine.js\"\n88\timport {\n89\t  subscribeAccelerometer, subscribeHeartRate,\n90\t  unsubscribeAll, processStepDetection, recordHeartRate,\n91\t  getHRZone, getPressureTrend\n92\t} from \"../../common/multi-sensor.js\"\n93\timport { countQueued, loadEvents, loadSettings } from \"../../common/storage.js\"\n94\timport { getScreenShape, padStr, fs, getCardRadius, getButtonRadius, getScreenHeight } from \"../../common/watch-face.js\"\n95\t\n96\tvar STEP_GOAL = 8000\n97\t\n98\tfunction pad(value) {\n99\t  return value < 10 ? \"0\" + value : String(value)\n100\t}\n101\t\n102\texport default {\n103\t  private: {\n104\t    clockText: \"--:--\",\n105\t    networkText: \"检测中\",\n106\t    networkClass: \"network-online\",\n107\t    statusClass: \"status-safe\",\n108\t    statusKicker: \"端侧守护中\",\n109\t    statusTitle: \"状态正常\",\n110\t    statusDescription: \"未发现安全风险\",\n111\t    currentG: \"1.00\", peakG: \"1.00\",\n112\t    stepCount: 0, stepProgress: 0,\n113\t    heartRate: \"--\", hrBar: 0, hrClass: \"hr-normal\", hrZone: \"\",\n114\t    sosLabel: \"立即求助 SOS\",\n115\t    sosOpacity: 1.0,\n116\t    pendingCount: 0,\n117\t    hasRecentEvent: false,\n118\t    recentEventIcon: \"\", recentEventIconClass: \"\", recentEventType: \"\", recentEventTime: \"\", recentEventId: \"\",\n119\t    pressureHint: \"\",\n120\t    contentPad: \"\",\n121\t    navOpacity: 1.0,\n122\t    fs8: 8, fs9: 9, fs10: 10, fs12: 12, fs13: 13, fs16: 16, fs18: 18, fs22: 22, fs24: 24,\n123\t    cr: 20, br: 23, cardPad: 14, metricPad: 14, quickPad: 12, scrollH: 0\n124\t  },\n125\t\n126\t  onInit() {\n127\t    this.scrollH = getScreenHeight()\n128\t    this.sampleWindow = createWindow(96)\n129\t    this.clockTimer = null\n130\t    this.sosPulseTimer = null\n131\t    this.liveSampleCount = 0\n132\t    this.liveAlertLocked = false\n133\t    this.lastAlertTime = 0\n134\t    this.computeStyles()\n135\t  },\n136\t\n137\t  computeStyles() {\n138\t    var r = getScreenShape().isRound\n139\t    this.contentPad = padStr()\n140\t    this.fs8 = fs(8); this.fs9 = fs(9); this.fs10 = fs(10); this.fs12 = fs(12)\n141\t    this.fs13 = fs(13); this.fs16 = fs(16); this.fs18 = fs(18)\n142\t    this.fs22 = fs(22); this.fs24 = fs(24)\n143\t    this.cr = getCardRadius(); this.br = getButtonRadius()\n144\t    this.cardPad = r ? 14 : 12; this.metricPad = r ? 14 : 10; this.quickPad = r ? 12 : 10\n145\t  },\n146\t\n147\t  onShow() {\n148\t    this.startClock(); this.refreshState(); this.startSensors(); this.startSosPulse()\n149\t  },\n150\t\n151\t  onHide() { this.stopClock(); this.stopSensors(); this.stopSosPulse() },\n152\t  onDestroy() { this.stopClock(); this.stopSensors(); this.stopSosPulse() },\n153\t\n154\t  startClock() {\n155\t    var page = this\n156\t    this.stopClock(); this.updateClock()\n157\t    this.clockTimer = setInterval(function() { page.updateClock() }, 1000)\n158\t  },\n159\t\n160\t  stopClock() { if (this.clockTimer) { clearInterval(this.clockTimer); this.clockTimer = null } },\n161\t\n162\t  updateClock() {\n163\t    var now = new Date()\n164\t    this.clockText = pad(now.getHours()) + \":\" + pad(now.getMinutes())\n165\t  },\n166\t\n167\t  // SOS 呼吸灯效果\n168\t  startSosPulse() {\n169\t    var page = this\n170\t    this.sosPulseTimer = setInterval(function() {\n171\t      page.sosOpacity = page.sosOpacity >= 1.0 ? 0.72 : 1.0\n172\t    }, 900)\n173\t  },\n174\t\n175\t  stopSosPulse() {\n176\t    if (this.sosPulseTimer) { clearInterval(this.sosPulseTimer); this.sosPulseTimer = null }\n177\t    this.sosOpacity = 1.0\n178\t  },\n179\t\n180\t  startSensors() {\n181\t    var page = this\n182\t    resetWindow(this.sampleWindow)\n183\t    this.liveSampleCount = 0; this.liveAlertLocked = false\n184\t\n185\t    subscribeAccelerometer(function(s) { page.onAccelSample(s) }, { interval: \"game\" })\n186\t    subscribeHeartRate(function(d) {\n187\t      var hr = d.heartRate || 0\n188\t      if (hr > 0) {\n189\t        page.heartRate = String(hr)\n190\t        var zone = getHRZone(hr)\n191\t        page.hrZone = zone.label\n192\t        page.hrClass = hr > 140 ? \"hr-high\" : hr > 100 ? \"hr-elevated\" : \"hr-normal\"\n193\t        page.hrBar = Math.min(Math.round((hr / 180) * 100), 100)\n194\t        recordHeartRate(hr)\n195\t      }\n196\t    })\n197\t  },\n198\t\n199\t  stopSensors() { unsubscribeAll() },\n200\t\n201\t  onAccelSample(sample) {\n202\t    if (this.liveAlertLocked) { return }\n203\t    sample.timestamp = Date.now()\n204\t    pushSample(this.sampleWindow, sample)\n205\t    this.liveSampleCount += 1\n206\t    var steps = processStepDetection(sample)\n207\t    this.stepCount = steps\n208\t    this.stepProgress = Math.min(Math.round((steps / STEP_GOAL) * 100), 100)\n209\t\n210\t    var g = Math.sqrt(sample.x * sample.x + sample.y * sample.y + sample.z * sample.z)\n211\t    this.peakG = Math.max(Number(this.peakG), g).toFixed(2)\n212\t\n213\t    var trend = getPressureTrend()\n214\t    if (trend.trend === \"falling\") { this.pressureHint = \"下降\" }\n215\t    else if (trend.trend === \"rising\") { this.pressureHint = \"上升\" }\n216\t    else { this.pressureHint = \"\" }\n217\t\n218\t    if (this.liveSampleCount >= 96 && this.liveSampleCount % 32 === 0) {\n219\t      var since = Date.now() - this.lastAlertTime\n220\t      if (since < 30000) { return }\n221\t      var result = assessWindow(this.sampleWindow)\n222\t      if (result.label !== \"normal\") {\n223\t        this.liveAlertLocked = true\n224\t        this.lastAlertTime = Date.now()\n225\t        this.openAlert(createAlert(result, \"真机 IMU\"))\n226\t      }\n227\t    }\n228\t  },\n229\t\n230\t  refreshState() {\n231\t    var page = this\n232\t    loadEvents(function(events) {\n233\t      page.pendingCount = countQueued(events)\n234\t      if (events.length > 0) {\n235\t        var r = events[0]\n236\t        page.hasRecentEvent = true; page.recentEventId = r.id\n237\t        page.recentEventType = r.typeLabel\n238\t        page.recentEventTime = r.timeLabel || formatTime(r.createdAt)\n239\t        if (r.status === \"cancelled\") { page.recentEventIcon = \"✓\"; page.recentEventIconClass = \"icon-safe\" }\n240\t        else if (r.status === \"queued\" || r.status === \"withdrawal_queued\") { page.recentEventIcon = \"!\"; page.recentEventIconClass = \"icon-queued\" }\n241\t        else if (r.status === \"withdrawn\") { page.recentEventIcon = \"✓\"; page.recentEventIconClass = \"icon-withdrawn\" }\n242\t        else { page.recentEventIcon = \"↑\"; page.recentEventIconClass = \"icon-sent\" }\n243\t      } else { page.hasRecentEvent = false }\n244\t    })\n245\t    loadSettings(function(s) { page.refreshNetwork(s.demoOffline) })\n246\t  },\n247\t\n248\t  refreshNetwork(demoOffline) {\n249\t    var page = this\n250\t    if (demoOffline) { this.networkText = \"离线\"; this.networkClass = \"network-offline\"; return }\n251\t    network.getType({\n252\t      success: function(d) {\n253\t        if (d.type === \"none\") { page.networkText = \"离线\"; page.networkClass = \"network-offline\" }\n254\t        else { page.networkText = d.type === \"wifi\" ? \"Wi-Fi\" : \"联网\"; page.networkClass = \"network-online\" }\n255\t      },\n256\t      fail: function() { page.networkText = \"模拟联网\"; page.networkClass = \"network-online\" }\n257\t    })\n258\t  },\n259\t\n260\t  openAlert(a) { this.$app.$def.setCurrentAlert(a); router.push({ uri: \"/pages/alert\" }) },\n261\t  triggerSos() { this.openAlert(createSosAlert()) },\n262\t  triggerSosLong() { this.openAlert(createSosAlert()) },\n263\t\n264\t  openRecentEvent() {\n265\t    var page = this\n266\t    loadEvents(function(events) {\n267\t      for (var i = 0; i < events.length; i++) {\n268\t        if (events[i].id === page.recentEventId) {\n269\t          page.$app.$def.setCurrentEvent(events[i]); router.push({ uri: \"/pages/event-detail\" }); return\n270\t        }\n271\t      }\n272\t    })\n273\t  },\n274\t\n275\t  openScenarios() { router.push({ uri: \"/pages/scenarios\" }) },\n276\t  openHistory() { router.push({ uri: \"/pages/history\" }) }\n277\t}\n278\t</script>\n279\t\n280\t<style>\n281\t.page { width: 100%; background-color: #050d0b; }\n282\t.content { width: 100%; flex-direction: column; }\n283\t\n284\t/* 防止 flex 塌陷 */\n285\t.topbar, .status-card, .metrics-row, .sos-btn, .quick-event, .nav-row, .hint, .footer-note { flex-shrink: 0; }\n286\t\n287\t.card { flex-direction: row; }\n288\t\n289\t/* 顶部栏 */\n290\t.topbar { width: 100%; flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }\n291\t.clock { color: #ffffff; font-weight: bold; }\n292\t.top-right { flex-direction: row; align-items: center; }\n293\t.queue-chip { padding: 3px 8px; margin-right: 5px; border-radius: 10px; background-color: rgba(255,184,74,0.15); color: #ffb84a; }\n294\t.badge { padding: 3px 8px; border-radius: 10px; color: #ffffff; }\n295\t.network-online { background-color: rgba(0,230,160,0.12); color: #00e6a0; }\n296\t.network-offline { background-color: rgba(255,107,90,0.12); color: #ff6b5a; }\n297\t\n298\t/* ─── 状态卡（accent bar 设计） ─────────────────── */\n299\t.status-card { width: 100%; margin-top: 8px; }\n300\t.accent-bar { width: 4px; border-radius: 2px; margin-right: 10px; }\n301\t.status-accent { background-color: #00e6a0; }\n302\t.accent-green { background-color: #00e6a0; }\n303\t.accent-red { background-color: #ff6b5a; }\n304\t.card-body { flex: 1; flex-direction: column; }\n305\t\n306\t.status-safe { background-color: #0a1a16; }\n307\t.status-monitoring { background-color: #0a1a25; }\n308\t.status-warning { background-color: #251210; }\n309\t.status-head { width: 100%; flex-direction: row; align-items: center; margin-bottom: 2px; }\n310\t.status-dot { width: 7px; height: 7px; margin-right: 5px; border-radius: 4px; background-color: #00e6a0; }\n311\t.status-kicker { color: #5a7a72; }\n312\t.status-title { color: #ffffff; font-weight: bold; margin-top: 2px; }\n313\t.status-desc { color: #a0b8b2; margin-top: 2px; }\n314\t\n315\t/* ─── 指标行 ──────────────────────────────── */\n316\t.metrics-row { width: 100%; flex-direction: row; justify-content: space-between; margin-top: 8px; }\n317\t.metric-card { width: 48%; background-color: #0a1a16; }\n318\t.metric-body { flex: 1; flex-direction: column; align-items: center; }\n319\t.metric-icon { margin-bottom: 2px; }\n320\t.metric-value { font-weight: bold; color: #ffffff; }\n321\t.metric-label { color: #5a7a72; margin-top: 1px; }\n322\t.hr-normal { color: #00e6a0; }\n323\t.hr-elevated { color: #ffb84a; }\n324\t.hr-high { color: #ff6b5a; }\n325\t.bar-track { width: 80%; height: 3px; margin-top: 6px; border-radius: 2px; background-color: #1a3029; }\n326\t.bar-fill { height: 3px; border-radius: 2px; }\n327\t.bar-green { background-color: #00e6a0; }\n328\t.bar-red { background-color: #ff6b5a; }\n329\t\n330\t/* ─── SOS 按钮 ──────────────────────────────── */\n331\t.sos-btn { width: 100%; padding-top: 14px; padding-bottom: 14px; margin-top: 10px; background-color: #ff5a4a; color: #ffffff; font-weight: bold; }\n332\t\n333\t/* ─── 最近事件 ──────────────────────────────── */\n334\t.quick-event { width: 100%; margin-top: 8px; background-color: #0a1a16; align-items: center; }\n335\t.qe-left { flex: 1; flex-direction: row; align-items: center; }\n336\t.qe-icon { width: 32px; height: 32px; border-radius: 16px; margin-right: 10px; justify-content: center; align-items: center; }\n337\t.icon-safe { background-color: rgba(0,230,160,0.12); }\n338\t.icon-queued { background-color: rgba(255,184,74,0.12); }\n339\t.icon-sent { background-color: rgba(0,184,255,0.12); }\n340\t.icon-withdrawn { background-color: rgba(176,122,255,0.12); }\n341\t.qe-icon-text { font-weight: bold; color: #ffffff; }\n342\t.qe-body { flex: 1; flex-direction: column; }\n343\t.qe-title { color: #ffffff; font-weight: bold; }\n344\t.qe-time { color: #5a7a72; margin-top: 1px; }\n345\t.qe-arrow { color: #3a5550; }\n346\t\n347\t/* ─── 导航行 ──────────────────────────────── */\n348\t.nav-row { width: 100%; flex-direction: row; justify-content: space-between; margin-top: 8px; }\n349\t.nav-btn { width: 48%; padding-top: 12px; padding-bottom: 12px; background-color: #0a1a16; color: #a0b8b2; font-weight: bold; }\n350\t\n351\t/* ─── 杂项 ─────────────────────────────── */\n352\t.hint { width: 100%; margin-top: 8px; text-align: center; color: #5a7a72; }\n353\t.footer-note { width: 100%; margin-top: 6px; text-align: center; color: #3a5550; }\n354\t</style>\n355\t", "is_error": false}
