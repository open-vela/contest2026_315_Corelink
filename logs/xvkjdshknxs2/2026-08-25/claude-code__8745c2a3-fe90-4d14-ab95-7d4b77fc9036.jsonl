 hrRotation }}deg);\">\n35\t            </div>\n36\t            <div class=\"ring-inner\">\n37\t              <text class=\"ring-icon\" style=\"font-size: {{ fs14 }}px;\">♥</text>\n38\t              <text class=\"ring-value\" style=\"font-size: {{ fs18 }}px;\">{{ heartRate }}</text>\n39\t              <text class=\"ring-unit\" style=\"font-size: {{ fs8 }}px;\">bpm</text>\n40\t            </div>\n41\t          </div>\n42\t\n43\t          <!-- 步数环 -->\n44\t          <div class=\"ring-group\">\n45\t            <div class=\"ring-outer\" style=\"width: {{ ringSize }}px; height: {{ ringSize }}px; border-radius: {{ ringHalf }}px; border-width: {{ ringStroke }}px; border-color: {{ stepRingColor }}; transform: rotate({{ stepRotation }}deg);\">\n46\t            </div>\n47\t            <div class=\"ring-inner\">\n48\t              <text class=\"ring-icon\" style=\"font-size: {{ fs14 }}px;\">⚡</text>\n49\t              <text class=\"ring-value\" style=\"font-size: {{ fs18 }}px;\">{{ stepCount }}</text>\n50\t              <text class=\"ring-unit\" style=\"font-size: {{ fs8 }}px;\">步</text>\n51\t            </div>\n52\t          </div>\n53\t        </div>\n54\t\n55\t        <!-- 安全状态条 -->\n56\t        <div class=\"safety-bar\" style=\"border-radius: {{ barRadius }}px;\">\n57\t          <div class=\"safety-bar-dot {{ safetyClass }}\"></div>\n58\t          <text class=\"safety-bar-text\" style=\"font-size: {{ fs12 }}px;\">{{ safetyText }}</text>\n59\t          <text class=\"safety-bar-extra\" style=\"font-size: {{ fs10 }}px;\">{{ safetyExtra }}</text>\n60\t        </div>\n61\t\n62\t        <!-- 进入按钮 -->\n63\t        <div class=\"enter-bar\" style=\"margin-top: {{ enterSpacer }}px; border-radius: {{ barRadius }}px;\">\n64\t          <text class=\"enter-text\" style=\"font-size: {{ fs13 }}px;\">轻触进入安全中心</text>\n65\t          <text class=\"enter-arrow\" style=\"font-size: {{ fs18 }}px;\">›</text>\n66\t        </div>\n67\t\n68\t      </div>\n69\t    </scroll>\n70\t  </stack>\n71\t</template>\n72\t\n73\t<script>\n74\timport router from \"@system.router\"\n75\timport { subscribeAccelerometer, subscribeHeartRate, unsubscribeAll, processStepDetection, getStepCount } from \"../../common/multi-sensor.js\"\n76\timport { loadEvents } from \"../../common/storage.js\"\n77\timport { getScreenShape, padStr, fs, getScreenHeight, getRingSize, getRingStroke } from \"../../common/watch-face.js\"\n78\t\n79\tvar WEEKDAYS = [\"星期日\", \"星期一\", \"星期二\", \"星期三\", \"星期四\", \"星期五\", \"星期六\"]\n80\tvar STEP_GOAL = 8000\n81\t\n82\tfunction pad(v) { return v < 10 ? \"0\" + v : String(v) }\n83\t\n84\texport default {\n85\t  private: {\n86\t    timeText: \"--:--\", dateText: \"--月--日\", weekdayText: \"--\", locationText: \"校园东区\",\n87\t    heartRate: \"--\", stepCount: \"0\",\n88\t    safetyText: \"守护中\", safetyExtra: \"\", safetyClass: \"safety-ok\",\n89\t    contentPad: \"\", enterSpacer: 0,\n90\t    // 环形进度\n91\t    ringSize: 56, ringHalf: 28, ringStroke: 4,\n92\t    hrRotation: 0, stepRotation: 0,\n93\t    hrRingColor: '#ff6b5a', stepRingColor: '#00e6a0',\n94\t    // 字体\n95\t    fs8: 8, fs10: 10, fs12: 12, fs13: 13, fs14: 14, fs18: 18, fs58: 58,\n96\t    barRadius: 20, scrollH: 0\n97\t  },\n98\t\n99\t  onInit() {\n100\t    this.clockTimer = null\n101\t    this.scrollH = getScreenHeight()\n102\t    this.computeStyles()\n103\t  },\n104\t\n105\t  computeStyles() {\n106\t    var r = getScreenShape().isRound\n107\t    this.contentPad = padStr()\n108\t    this.enterSpacer = r ? 30 : 50\n109\t    this.fs8 = fs(8); this.fs10 = fs(10); this.fs12 = fs(12); this.fs13 = fs(13)\n110\t    this.fs14 = fs(14); this.fs18 = fs(18); this.fs58 = fs(58)\n111\t    this.barRadius = r ? 24 : 20\n112\t    this.ringSize = getRingSize()\n113\t    this.ringHalf = Math.floor(this.ringSize / 2)\n114\t    this.ringStroke = getRingStroke()\n115\t  },\n116\t\n117\t  onShow() {\n118\t    var page = this\n119\t    this.stopClock()\n120\t    this.updateClock()\n121\t    this.clockTimer = setInterval(function() { page.updateClock() }, 1000)\n122\t\n123\t    subscribeAccelerometer(function(s) { processStepDetection(s); page.stepCount = String(getStepCount()); page.updateStepRing() }, { interval: \"normal\" })\n124\t    subscribeHeartRate(function(d) {\n125\t      if (d.heartRate) {\n126\t        page.heartRate = String(d.heartRate)\n127\t        page.updateHrRing(d.heartRate)\n128\t      }\n129\t    })\n130\t\n131\t    loadEvents(function(events) {\n132\t      var q = 0\n133\t      for (var i = 0; i < events.length; i++) {\n134\t        if (events[i].status === \"queued\" || events[i].status === \"withdrawal_queued\") q++\n135\t      }\n136\t      if (q > 0) { page.safetyText = q + \" 条待补发\"; page.safetyExtra = \"·\"; page.safetyClass = \"safety-warn\" }\n137\t      else { page.safetyText = \"守护中\"; page.safetyExtra = \"\"; page.safetyClass = \"safety-ok\" }\n138\t    })\n139\t  },\n140\t\n141\t  onHide() { this.stopClock(); unsubscribeAll() },\n142\t  onDestroy() { this.stopClock(); unsubscribeAll() },\n143\t\n144\t  updateClock() {\n145\t    var now = new Date()\n146\t    this.timeText = pad(now.getHours()) + \":\" + pad(now.getMinutes())\n147\t    this.dateText = pad(now.getMonth() + 1) + \"月\" + pad(now.getDate()) + \"日\"\n148\t    this.weekdayText = WEEKDAYS[now.getDay()]\n149\t  },\n150\t\n151\t  updateHrRing(hr) {\n152\t    // 心率范围 60-180，映射到 0-270 度\n153\t    var clamped = Math.max(60, Math.min(180, hr))\n154\t    var pct = (clamped - 60) / 120\n155\t    this.hrRotation = -90 + Math.round(pct * 270)\n156\t    if (hr > 140) { this.hrRingColor = '#ff6b5a' }\n157\t    else if (hr > 100) { this.hrRingColor = '#ffb84a' }\n158\t    else { this.hrRingColor = '#ff8a7a' }\n159\t  },\n160\t\n161\t  updateStepRing() {\n162\t    var steps = parseInt(this.stepCount) || 0\n163\t    var pct = Math.min(steps / STEP_GOAL, 1)\n164\t    this.stepRotation = -90 + Math.round(pct * 360)\n165\t  },\n166\t\n167\t  stopClock() { if (this.clockTimer) { clearInterval(this.clockTimer); this.clockTimer = null } },\n168\t  enterApp() { router.push({ uri: \"/pages/home\" }) }\n169\t}\n170\t</script>\n171\t\n172\t<style>\n173\t.page { width: 100%; height: 100%; background-color: #030a08; }\n174\t\n175\t/* 多层背景模拟渐变 */\n176\t.bg-base { position: absolute; width: 100%; height: 100%; background-color: #050d0b; }\n177\t.bg-glow { position: absolute; width: 100%; height: 100%; background-color: #0a1a16; opacity: 0.4; }\n178\t\n179\t.overlay-scroll { width: 100%; position: absolute; }\n180\t.overlay { width: 100%; flex-direction: column; }\n181\t.top-bar, .time-section, .rings-section, .safety-bar, .enter-bar { flex-shrink: 0; }\n182\t\n183\t/* 顶部状态栏 */\n184\t.top-bar { width: 100%; flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; }\n185\t.location-chip { flex-direction: row; padding: 4px 10px; border-radius: 12px; background-color: rgba(10,26,22,0.85); align-items: center; }\n186\t.location-dot { color: #00e6a0; margin-right: 5px; }\n187\t.location-text { color: #a0b8b2; }\n188\t.safety-indicator { flex-direction: row; align-items: center; }\n189\t.safety-dot { width: 8px; height: 8px; border-radius: 4px; }\n190\t.safety-ok { background-color: #00e6a0; }\n191\t.safety-warn { background-color: #ffb84a; }\n192\t\n193\t/* 大时间 */\n194\t.time-section { width: 100%; flex-direction: column; align-items: center; margin-top: 4px; margin-bottom: 8px; }\n195\t.time-text { color: #ffffff; font-weight: bold; letter-spacing: 2px; }\n196\t.date-row { flex-direction: row; align-items: center; margin-top: 2px; }\n197\t.weekday-text { color: #00e6a0; font-weight: bold; margin-right: 8px; }\n198\t.date-text { color: #a0b8b2; }\n199\t\n200\t/* 双环区域 */\n201\t.rings-section { width: 100%; flex-direction: row; justify-content: center; align-items: center; margin-top: 6px; margin-bottom: 10px; }\n202\t.ring-group { width: 70px; height: 70px; margin-left: 10px; margin-right: 10px; justify-content: center; align-items: center; }\n203\t.ring-