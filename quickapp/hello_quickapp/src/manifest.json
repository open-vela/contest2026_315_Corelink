{
  "package": "com.openvela.contest.velaguard",
  "name": "VelaGuard",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.network"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.sensor"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width"
  },
  "router": {
    "entry": "pages/cover",
    "pages": {
      "pages/cover": {
        "component": "cover"
      },
      "pages/home": {
        "component": "home"
      },
      "pages/scenarios": {
        "component": "scenarios"
      },
      "pages/alert": {
        "component": "alert"
      },
      "pages/history": {
        "component": "history"
      },
      "pages/all-events": {
        "component": "all-events"
      },
      "pages/event-detail": {
        "component": "event-detail"
      },
      "pages/contacts": {
        "component": "contacts"
      },
      "pages/settings": {
        "component": "settings"
      }
    }
  }
}
