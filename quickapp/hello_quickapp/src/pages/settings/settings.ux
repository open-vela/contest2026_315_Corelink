<template>
  <scroll class="page" scroll-y="true">
    <div class="content">
      <div class="header">
        <input class="back-button" type="button" value="‹" onclick="goBack" />
        <div class="header-copy">
          <text class="title">演示设置</text>
          <text class="subtitle">控制数据源与联网状态</text>
        </div>
      </div>

      <div class="setting-card">
        <div class="setting-head">
          <div class="setting-copy">
            <text class="setting-title">网络故障注入</text>
            <text class="setting-note">验证离线队列和恢复补发</text>
          </div>
          <text class="state-chip {{ networkStateClass }}">{{ networkStateText }}</text>
        </div>
        <input
          class="action-button"
          type="button"
          value="{{ networkActionText }}"
          onclick="toggleOffline"
        />
      </div>

      <div class="setting-card">
        <div class="setting-head">
          <div class="setting-copy">
            <text class="setting-title">紧急联系人</text>
            <text class="setting-note">配置两级通知顺序和脱敏联系方式</text>
          </div>
          <text class="state-chip contact-chip">P1 / P2</text>
        </div>
        <input
          class="action-button contact-button"
          type="button"
          value="管理紧急联系人"
          onclick="openContacts"
        />
      </div>

      <div class="setting-card">
        <div class="setting-head">
          <div class="setting-copy">
            <text class="setting-title">IMU 数据源</text>
            <text class="setting-note">模拟器建议使用可复现回放</text>
          </div>
          <text class="state-chip source-chip">{{ sourceStateText }}</text>
        </div>
        <input
          class="action-button secondary-button"
          type="button"
          value="{{ sourceActionText }}"
          onclick="toggleSensor"
        />
      </div>

      <div class="delivery-card" if="{{ lastFlushCount > 0 }}">
        <text class="delivery-value">{{ lastFlushCount }}</text>
        <div>
          <text class="delivery-title">条离线求助已补发</text>
          <text class="delivery-note">事件历史中已标记为“已补发”</text>
        </div>
      </div>

      <div class="explain-card">
        <text class="explain-title">推荐答辩演示顺序</text>
        <text class="explain-item">1. 跑步与剧烈晃动：证明不会轻易误报</text>
        <text class="explain-item">2. 打开离线模式，再运行疑似跌倒</text>
        <text class="explain-item">3. 倒计时结束，事件进入待发送队列</text>
        <text class="explain-item">4. 恢复联网，展示自动补发和本地留痕</text>
      </div>

      <text class="footer">模拟开关只服务于比赛演示，不代表真实设备网络状态。</text>
    </div>
  </scroll>
</template>

<script>
import router from "@system.router"
import {flushQueuedEvents, loadSettings, saveSettings} from "../../common/storage.js"

export default {
  private: {
    demoOffline: false,
    useRealSensor: false,
    networkStateText: "联网",
    networkStateClass: "state-online",
    networkActionText: "切换为离线演示",
    sourceStateText: "回放",
    sourceActionText: "尝试使用真机 IMU",
    lastFlushCount: 0
  },

  onShow() {
    const page = this
    loadSettings(function(settings) {
      page.demoOffline = settings.demoOffline
      page.useRealSensor = settings.useRealSensor
      page.refreshLabels()
    })
  },

  refreshLabels() {
    this.networkStateText = this.demoOffline ? "离线" : "联网"
    this.networkStateClass = this.demoOffline ? "state-offline" : "state-online"
    this.networkActionText = this.demoOffline ? "恢复联网并补发" : "切换为离线演示"
    this.sourceStateText = this.useRealSensor ? "真机 IMU" : "回放"
    this.sourceActionText = this.useRealSensor ? "切换为演示回放" : "尝试使用真机 IMU"
  },

  persist(callback) {
    saveSettings(
      {
        demoOffline: this.demoOffline,
        useRealSensor: this.useRealSensor
      },
      callback
    )
  },

  toggleOffline() {
    const page = this
    this.demoOffline = !this.demoOffline
    this.refreshLabels()
    this.persist(function() {
      if (!page.demoOffline) {
        flushQueuedEvents(function(count) {
          page.lastFlushCount = count
        })
      }
    })
  },

  toggleSensor() {
    this.useRealSensor = !this.useRealSensor
    this.refreshLabels()
    this.persist()
  },

  openContacts() {
    router.push({
      uri: "/pages/contacts"
    })
  },

  goBack() {
    router.back()
  }
}
</script>

