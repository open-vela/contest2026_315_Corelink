  width: 100%;
  align-items: center;
}

.status-dot {
  width: 8px;
  height: 8px;
  margin-right: 6px;
  border-radius: 4px;
  background-color: #76f0c2;
}

.result-kicker {
  color: #a7c8c0;
  font-size: 10px;
}

.result-title {
  color: #ffffff;
  font-size: 25px;
  font-weight: bold;
  margin-top: 3px;
}

.result-description {
  color: #b8ccc6;
  font-size: 11px;
  margin-top: 2px;
}

.metric-row {
  width: 100%;
  margin-top: 12px;
  justify-content: space-between;
}

.metric {
  width: 31%;
  height: 43px;
  border-radius: 12px;
  background-color: #09251f;
