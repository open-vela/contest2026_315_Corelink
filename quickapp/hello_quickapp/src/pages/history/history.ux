<template>
  <div class="page">
    <div class="header">
      <input class="back-button" type="button" value="‹" onclick="goBack" />
      <div class="header-title-block">
        <text class="title">事件历史</text>
        <text class="subtitle">本地留痕 · 最多保留 30 条</text>
      </div>
      <input class="clear-button" type="button" value="清空" onclick="clearAll" />
    </div>

    <div class="summary-row">
      <div class="summary-card" onclick="openAllEvents">
        <text class="summary-value">{{ totalCount }}</text>
        <text class="summary-label">全部事件</text>
      </div>
      <div class="summary-card warning-card">
        <text class="summary-value">{{ queuedCount }}</text>
        <text class="summary-label">等待补发</text>
      </div>
    </div>

    <div class="empty-state" if="{{ events.length === 0 }}">
      <text class="empty-icon">✓</text>
      <text class="empty-title">暂无安全事件</text>
      <text class="empty-note">从首页运行场景实验后，处理结果会保存在这里</text>
    </div>

    <list class="event-list" else>
      <list-item
        class="event-card"
        type="event"
        for="{{ events }}"
        tid="id"
        onclick="openDetail($item.id)"
      >
        <div class="event-top">
          <div class="event-icon {{ $item.iconClass }}">
            <text class="event-icon-text">{{ $item.icon }}</text>
          </div>
          <div class="event-copy">
            <text class="event-sequence">{{ $item.sequenceLabel }}</text>
            <text class="event-title">{{ $item.typeLabel }}</text>
            <text class="event-time">{{ $item.fullTimeLabel }}</text>
          </div>
        </div>
        <div class="event-result-row">
          <div class="event-result-copy">
            <text class="event-result">{{ $item.resultLabel }}</text>
            <text class="event-source">来源：{{ $item.source }}</text>
          </div>
          <text class="event-status {{ $item.statusClass }}">{{ $item.statusLabel }}</text>
        </div>
        <div class="event-meta">
          <text class="event-meta-text">可信度 {{ $item.confidence }}%</text>
          <text class="event-meta-text">峰值 {{ $item.peakG }}g</text>
          <text class="event-open">查看详情 ›</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import {clearEvents, countQueued, loadEvents} from "../../common/storage.js"

function pad(value) {
  return value < 10 ? "0" + value : String(value)
}

function fullTimeLabel(event) {
  if (!event.createdAt) {
    return event.timeLabel
  }
  const date = new Date(event.createdAt)
  return (
    date.getFullYear() +
    "-" +
    pad(date.getMonth() + 1) +
    "-" +
    pad(date.getDate()) +
    " " +
    pad(date.getHours()) +
    ":" +
    pad(date.getMinutes()) +
    ":" +
    pad(date.getSeconds())
  )
}

function decorate(event) {
  const item = event
  if (event.status === "cancelled") {
    item.icon = "✓"
    item.iconClass = "icon-safe"
    item.statusClass = "status-safe"
  } else if (event.status === "queued") {
    item.icon = "!"
    item.iconClass = "icon-queued"
    item.statusClass = "status-queued"
  } else if (event.status === "withdrawal_queued") {
    item.icon = "↶"
    item.iconClass = "icon-queued"
    item.statusClass = "status-queued"
  } else if (event.status === "withdrawn") {
    item.icon = "✓"
    item.iconClass = "icon-withdrawn"
    item.statusClass = "status-withdrawn"
  } else {
    item.icon = "↑"
    item.iconClass = "icon-sent"
    item.statusClass = "status-sent"
  }
  return item
}

export default {
  private: {
    events: [],
    totalCount: 0,
    queuedCount: 0
  },

  openDetail(eventId) {
    for (let index = 0; index < this.events.length; index += 1) {
      if (this.events[index].id === eventId) {
        this.$app.$def.setCurrentEvent(this.events[index])
        router.push({
          uri: "/pages/event-detail"
        })
        return
      }
    }
  },

  openAllEvents() {
    router.push({
      uri: "/pages/all-events"
    })
  },

  onShow() {
    this.reload()
  },

  reload() {
    const page = this
    loadEvents(function(events) {
      const decorated = []
      for (let index = 0; index < events.length; index += 1) {
        const item = decorate(events[index])
        item.sequenceLabel = "事件 #" + (events.length - index)
        item.fullTimeLabel = fullTimeLabel(item)
        decorated.push(item)
      }
      page.events = decorated
      page.totalCount = decorated.length
      page.queuedCount = countQueued(decorated)
    })
  },

  clearAll() {
    const page = this
    clearEvents(function() {
      page.events = []
      page.totalCount = 0
      page.queuedCount = 0
    })
  },

  goBack() {
    router.back()
  }
}
</script>

