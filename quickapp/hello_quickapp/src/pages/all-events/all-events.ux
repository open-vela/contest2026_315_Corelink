<template>
  <scroll class="page" scroll-y="true">
    <div class="content">
      <div class="header">
        <input class="back-button" type="button" value="‹" onclick="goBack" />
        <div class="header-copy">
          <text class="title">全部事件</text>
          <text class="subtitle">共 {{ totalCount }} 条 · 点击查看完整详情</text>
        </div>
      </div>

      <div class="empty-state" if="{{ events.length === 0 }}">
        <text class="empty-title">暂无安全事件</text>
        <text class="empty-note">完成场景测试或 SOS 处置后，事件会保存在这里。</text>
      </div>

      <div
        class="event-card"
        for="{{ events }}"
        tid="id"
        onclick="openDetail($item.id)"
      >
        <div class="event-heading">
          <div class="event-index">
            <text class="event-index-text">{{ $item.sequence }}</text>
          </div>
          <div class="event-copy">
            <text class="event-title">{{ $item.typeLabel }}</text>
            <text class="event-time">{{ $item.fullTimeLabel }}</text>
          </div>
          <text class="event-status {{ $item.statusClass }}">{{ $item.statusLabel }}</text>
        </div>

        <text class="event-result">{{ $item.resultLabel }}</text>
        <text class="event-source">来源：{{ $item.source }}</text>

        <div class="event-footer">
          <text class="event-meta">可信度 {{ $item.confidence }}%</text>
          <text class="event-meta">峰值 {{ $item.peakG }}g</text>
          <text class="event-open">查看详情 ›</text>
        </div>
      </div>
    </div>
  </scroll>
</template>

<script>
import router from "@system.router"
import {loadEvents} from "../../common/storage.js"

function pad(value) {
  return value < 10 ? "0" + value : String(value)
}

function fullTimeLabel(event) {
  if (!event.createdAt) {
    return event.timeLabel
  }
  const date = new Date(event.createdAt)
  return (
    date.getFullYear() +
    "-" +
    pad(date.getMonth() + 1) +
    "-" +
    pad(date.getDate()) +
    " " +
    pad(date.getHours()) +
    ":" +
    pad(date.getMinutes()) +
    ":" +
    pad(date.getSeconds())
  )
}

function statusClassFor(status) {
  if (status === "queued" || status === "withdrawal_queued") {
    return "status-queued"
  }
  if (status === "withdrawn") {
    return "status-withdrawn"
  }
  if (status === "cancelled") {
    return "status-safe"
  }
  return "status-sent"
}

export default {
  private: {
    events: [],
    totalCount: 0
  },

  onShow() {
    const page = this
    loadEvents(function(events) {
      const displayed = []
      for (let index = 0; index < events.length; index += 1) {
        const event = events[index]
        event.sequence = events.length - index
        event.fullTimeLabel = fullTimeLabel(event)
        event.statusClass = statusClassFor(event.status)
        displayed.push(event)
      }
      page.events = displayed
      page.totalCount = displayed.length
    })
  },

  openDetail(eventId) {
    for (let index = 0; index < this.events.length; index += 1) {
      if (this.events[index].id === eventId) {
        this.$app.$def.setCurrentEvent(this.events[index])
        router.push({
          uri: "/pages/event-detail"
        })
        return
      }
    }
  },

  goBack() {
    router.back()
  }
}
</script>

