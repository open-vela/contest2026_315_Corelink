  width: 100%;
  align-items: center;
}

.event-index {
  width: 38px;
  height: 38px;
  margin-right: 10px;
  border-radius: 19px;
  background-color: #174438;
  justify-content: center;
  align-items: center;
}

.event-index-text {
  color: #77e9bd;
  font-size: 15px;
  font-weight: bold;
}

