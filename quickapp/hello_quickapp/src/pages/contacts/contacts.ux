<template>
  <scroll id="contactScroll" class="page" scroll-y="true">
    <div class="content">
      <div class="header">
        <input class="back-button" type="button" value="‹" onclick="goBack" />
        <div class="header-copy">
          <text class="title">紧急联系人</text>
          <text class="subtitle">仅保存脱敏联系方式</text>
        </div>
      </div>

      <div class="page-tabs">
        <input
          class="page-tab {{ primaryTabClass }}"
          type="button"
          value="第一联系人"
          onclick="showPage(0)"
        />
        <input
          class="page-tab {{ secondaryTabClass }}"
          type="button"
          value="第二联系人"
          onclick="showPage(1)"
        />
        <input
          class="page-tab {{ saveTabClass }}"
          type="button"
          value="保存设置"
          onclick="showPage(2)"
        />
      </div>

      <div class="page-panel" if="{{ currentPage === 0 }}">
        <div class="privacy-card">
          <text class="privacy-title">隐私提示</text>
          <text class="privacy-note">
            初赛原型不发送真实短信。请填写138****2468一类掩码，不要提交真实手机号。
          </text>
        </div>

        <div class="contact-card">
          <div class="contact-head">
            <text class="priority-chip">P1</text>
            <div class="contact-copy">
              <text class="contact-title">第一联系人</text>
              <text class="contact-note">优先生成通知状态</text>
            </div>
          </div>
          <text class="field-label">联系人姓名</text>
          <input
            class="text-field"
            type="text"
            value="{{ primaryName }}"
            onchange="onPrimaryNameChange"
          />
          <text class="field-label">联系方式掩码</text>
          <input
            class="text-field"
            type="text"
            value="{{ primaryContact }}"
            onchange="onPrimaryContactChange"
          />
        </div>
      </div>

      <div class="page-panel" if="{{ currentPage === 1 }}">
        <div class="contact-card">
          <div class="contact-head">
            <text class="priority-chip priority-two">P2</text>
            <div class="contact-copy">
              <text class="contact-title">第二联系人</text>
              <text class="contact-note">第一联系人之后通知</text>
            </div>
          </div>
          <text class="field-label">联系人姓名</text>
          <input
            class="text-field"
            type="text"
            value="{{ secondaryName }}"
            onchange="onSecondaryNameChange"
          />
          <text class="field-label">联系方式掩码</text>
          <input
            class="text-field"
            type="text"
            value="{{ secondaryContact }}"
            onchange="onSecondaryContactChange"
          />
        </div>
      </div>

      <div class="page-panel" if="{{ currentPage === 2 }}">
        <input
          class="swap-button"
          type="button"
          value="交换 P1 / P2 通知优先级"
          onclick="swapPriority"
        />
        <input class="save-button" type="button" value="保存联系人配置" onclick="save" />
        <text class="saved-text" if="{{ saved }}">{{ savedText }}</text>
      </div>

      <div class="page-controls">
        <div class="page-button-placeholder" if="{{ currentPage === 0 }}"></div>
        <input
          class="page-button"
          if="{{ currentPage > 0 }}"
          type="button"
          value="‹ 上一页"
          onclick="previousPage"
        />
        <text class="page-indicator">{{ pageIndicator }}</text>
        <div class="page-button-placeholder" if="{{ currentPage === 2 }}"></div>
        <input
          class="page-button next-button"
          if="{{ currentPage < 2 }}"
          type="button"
          value="下一页 ›"
          onclick="nextPage"
        />
      </div>
    </div>
  </scroll>
</template>

<script>
import router from "@system.router"
import {loadContacts, saveContacts} from "../../common/storage.js"

function eventValue(event, fallback) {
  if (event && event.value !== undefined) {
    return event.value
  }
  return fallback
}

export default {
  private: {
    currentPage: 0,
    pageIndicator: "1 / 3",
    primaryTabClass: "page-tab-active",
    secondaryTabClass: "",
    saveTabClass: "",
    primaryName: "",
    primaryContact: "",
    secondaryName: "",
    secondaryContact: "",
    saved: false,
    savedText: ""
  },

  onShow() {
    const page = this
    loadContacts(function(contacts) {
      page.primaryName = contacts[0].name
      page.primaryContact = contacts[0].maskedContact
      page.secondaryName = contacts[1].name
      page.secondaryContact = contacts[1].maskedContact
    })
  },

  showPage(pageIndex) {
    this.currentPage = pageIndex
    this.pageIndicator = pageIndex + 1 + " / 3"
    this.primaryTabClass = pageIndex === 0 ? "page-tab-active" : ""
    this.secondaryTabClass = pageIndex === 1 ? "page-tab-active" : ""
    this.saveTabClass = pageIndex === 2 ? "page-tab-active" : ""
    this.scrollToTop()
  },

  previousPage() {
    if (this.currentPage > 0) {
      this.showPage(this.currentPage - 1)
    }
  },

  nextPage() {
    if (this.currentPage < 2) {
      this.showPage(this.currentPage + 1)
    }
  },

  scrollToTop() {
    const page = this
    setTimeout(function() {
      try {
        const contactScroll = page.$element("contactScroll")
        if (contactScroll) {
          contactScroll.scrollTo({
            top: 0,
            left: 0,
            behavior: "instant"
          })
        }
      } catch (error) {
        console.log("contact scroll reset skipped", error)
      }
    }, 0)
  },

  onPrimaryNameChange(event) {
    this.primaryName = eventValue(event, this.primaryName)
    this.saved = false
  },

  onPrimaryContactChange(event) {
    this.primaryContact = eventValue(event, this.primaryContact)
    this.saved = false
  },

  onSecondaryNameChange(event) {
    this.secondaryName = eventValue(event, this.secondaryName)
    this.saved = false
  },

  onSecondaryContactChange(event) {
    this.secondaryContact = eventValue(event, this.secondaryContact)
    this.saved = false
  },

  swapPriority() {
    const name = this.primaryName
    const contact = this.primaryContact
    this.primaryName = this.secondaryName
    this.primaryContact = this.secondaryContact
    this.secondaryName = name
    this.secondaryContact = contact
    this.saved = false
  },

  save() {
    const page = this
    const contacts = [
      {
        id: "contact-1",
        name: this.primaryName || "第一联系人",
        maskedContact: this.primaryContact || "***",
        priority: 1
      },
      {
        id: "contact-2",
        name: this.secondaryName || "第二联系人",
        maskedContact: this.secondaryContact || "***",
        priority: 2
      }
    ]
    saveContacts(contacts, function() {
      page.saved = true
      page.savedText = "已保存：通知顺序为 " + contacts[0].name + " → " + contacts[1].name
    })
  },

  goBack() {
    router.back()
  }
}
</script>

