  padding: 5px 8px;
  margin-right: 6px;
  border-radius: 12px;
  background-color: #49351b;
  color: #ffd27e;
  font-size: 10px;
}

.status-card {
  width: 100%;
  height: 156px;
  margin-top: 7px;
  padding: 15px;
  border-radius: 22px;
  flex-direction: column;
}

.status-safe {
  background-color: #0d3b30;
}

.status-monitoring {
  background-color: #173751;
}

.status-warning {
  background-color: #632d26;
}

.status-head {
  width: 100%;
  align-items: center;
}

.status-dot {
  width: 8px;
  height: 8px;
  margin-right: 6px;
  border-radius: 4px;
  background-color: #7affd4;
}

.status-kicker {
  flex: 1;
  color: #a7c8c0;
  font-size: 10px;
}

.source-chip {
  padding: 3px 7px;
  border-radius: 9px;
  background-color: #163f35;
  color: #80e6bd;
  font-size: 9px;
}

.status-title {
  color: #ffffff;
  font-size: 28px;
  font-weight: bold;
  margin-top: 3px;
}

.status-description {
  color: #c6d8d3;
  font-size: 12px;
  margin-top: 1px;
}

.metric-row {
  width: 100%;
  margin-top: 11px;
  justify-content: space-between;
}

.metric {
  width: 31%;
  height: 43px;
  background-color: #09251f;
  border-radius: 12px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.metric-value {
  color: #ffffff;
  font-size: 17px;
  font-weight: bold;
}

.metric-label {
  color: #92aaa4;
  font-size: 9px;
}

.sos-button {
  width: 100%;
  height: 50px;
  margin-top: 12px;
  border-radius: 25px;
  background-color: #ff5d50;
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
}

.nav-row {
  width: 100%;
  height: 48px;
  margin-top: 10px;
  justify-content: space-between;
}

.nav-button {
  width: 31%;
  height: 48px;
  border-radius: 18px;
  background-color: #172824;
  color: #cce0da;
  font-size: 12px;
}

.disclaimer {
  width: 100%;
  margin-top: 9px;
  text-align: center;
  color: #526762;
  font-size: 9px;
}
</style>
